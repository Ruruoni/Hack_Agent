# Copy this file to ".env" (scripts\setup.ps1 does it for you). Lines starting with # are ignored.
# Every NEXUS_* variable can also be changed later in the web UI (Settings); UI changes are saved to data\settings.json and win over this file.

# --- LM Studio -------------------------------------------------------------------------
NEXUS_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Only needed if you enabled authentication on the LM Studio server:
NEXUS_LMSTUDIO_API_KEY=
# Leave empty to use whichever chat model is loaded in LM Studio:
NEXUS_CHAT_MODEL=
# Tokens NEXUS budgets for a prompt. Set it to the context length you loaded the model with.
NEXUS_CONTEXT_WINDOW=8192

# --- Embeddings (semantic search) ---------------------------------------------------------
# hash = built-in, offline, lexical (works out of the box)
# lmstudio = an embedding model loaded in LM Studio (recommended, e.g. nomic-embed-text)
NEXUS_EMBEDDING_PROVIDER=hash
NEXUS_EMBEDDING_MODEL=

# --- Storage ----------------------------------------------------------------------------
# Default: <project folder>\data . Use an absolute path to put it on another drive.
NEXUS_DATA_DIR=
# auto = ChromaDB if installed, else the built-in SQLite vector store
NEXUS_VECTOR_BACKEND=auto

# --- Safety -------------------------------------------------------------------------------
# read_only | approval_required | restricted_automation
NEXUS_EXECUTION_MODE=approval_required

# --- Web research -------------------------------------------------------------------------
# none | searxng | brave
NEXUS_SEARCH_PROVIDER=none
NEXUS_SEARCH_URL=
NEXUS_SEARCH_API_KEY=

# --- Secrets for dataset downloads (read from the environment ONLY - never type tokens into the chat) ---
# Needed only for gated/private Hugging Face datasets. Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=
